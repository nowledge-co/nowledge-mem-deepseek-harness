{
  "name": "nowledge-mem-deepseek-harness",
  "version": "0.1.6",
  "description": "One memory layer for every AI tool and agent, packaged for DeepSeek Harness with startup context, prompt-time recall, Mem MCP tools, and DSH thread capture.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "client.js.map",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "homepage": "https://mem.nowledge.co/docs/integrations/deepseek-harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/nowledge-co/nowledge-mem-deepseek-harness.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "nowledge",
    "nowledge-mem",
    "memory",
    "knowledge-graph",
    "mcp"
  ],
  "author": {
    "name": "Nowledge Labs",
    "url": "https://nowledge-labs.ai"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-shell": ">=0.0.1-rc.5 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.0.1-rc.1 <0.2.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
